{
	"name": "tahu-uap",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260518.1",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"bits-ui": "^2.18.1",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.37.1",
		"@elysiajs/eden": "^1.4.9",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.28",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7"
	}
}
