{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tahu-uap",
	"compatibility_date": "2026-05-18",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arus-kas-db",
			"database_id": "arus-kas-db-local",
			"migrations_dir": "drizzle"
		}
	]
}
